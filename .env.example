# Copy to .env and fill in. Never commit .env.

# Upstream provider key(s) — LiteLLM will use these to call real models.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=

# Master key for the local LiteLLM proxy (generate a long random string).
LITELLM_MASTER_KEY=sk-lab-change-me

# Optional: Postgres for virtual keys / spend tracking (compose provides one).
# DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm

# Soft monthly budget for the lab virtual key (USD). Enforce in LiteLLM UI/API.
LAB_VK_MAX_BUDGET=5.00
LAB_VK_BUDGET_DURATION=30d
